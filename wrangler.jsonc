// Cloudflare Worker for the site: serves the built game (dist/) and the small
// /api/* endpoints in worker/. "name" must match your Worker's name in the
// Cloudflare dashboard (Workers & Pages); change it here if yours differs.
{
  "name": "fps-game",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  // Keep variables set in the dashboard (TURN_URLS, TURN_USERNAME...) across deploys.
  "keep_vars": true,
  // Relay login (TURN_URLS, TURN_USERNAME, TURN_CREDENTIAL) lives in the dashboard as Secrets,
  // which deploys never touch. Don't add them here: same-named vars would clash with the secrets.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API runs the script; everything else is plain static files.
    "run_worker_first": ["/api/*"]
  },
  // Live player counter, and accounts (sign-in, cloud saves, friends, admin).
  // Free plan: Durable Objects must use the SQLite backend.
  // The admin account is made from two dashboard Secrets: ADMIN_EMAIL and ADMIN_PASSWORD.
  "durable_objects": {
    "bindings": [
      { "name": "PRESENCE", "class_name": "Presence" },
      { "name": "ACCOUNTS", "class_name": "Accounts" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Presence"] },
    { "tag": "v2", "new_sqlite_classes": ["Accounts"] }
  ]
}
